# Copy this file to .env and fill in the keys. .env is ignored by git.
# The chat (Claude Sonnet 5.5) and the lease reader (Claude Haiku 5.5), both from Anthropic (see config.py).
ANTHROPIC_API_KEY=your-key-here
# Only for the OpenRouter models (GATEWAY=openrouter or READER_GATEWAY=openrouter, and comparisons/models/).
OPENROUTER_API_KEY=your-key-here
# Only for the UF models (GATEWAY=uf or READER_GATEWAY=uf) and the comparisons' judge.
UF_API_KEY=your-key-here
